<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Krishkumar Avaiya — Cloud Engineer, Full-Stack & AI DevOps</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap"
    rel="stylesheet" />
  <style>
    :root {
      --bg: #050a0f;
      --bg2: #0b1420;
      --bg3: #0f1f33;
      --accent: #00d4ff;
      --accent2: #00ff9d;
      --accent3: #7b61ff;
      --text: #e8f4f8;
      --muted: #7a9ab0;
      --card: rgba(15, 31, 51, 0.7);
      --border: rgba(0, 212, 255, 0.15);
      --glow: 0 0 30px rgba(0, 212, 255, 0.2);
    }

    [data-theme="steel"] {
      --bg: #0f172a;
      --bg2: #1e293b;
      --bg3: #334155;
      --accent: #38bdf8;
      --accent2: #fb7185;
      --accent3: #a855f7;
      --text: #f8fafc;
      --muted: #94a3b8;
      --card: rgba(30, 41, 59, 0.7);
      --border: rgba(56, 189, 248, 0.15);
      --glow: 0 0 30px rgba(56, 189, 248, 0.2);
    }

    .theme-toggle-btn {
      background: rgba(0, 212, 255, 0.08);
      border: 1px solid var(--border);
      color: var(--accent);
      cursor: pointer;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      transition: all 0.3s;
      outline: none;
    }

    .theme-toggle-btn:hover {
      background: var(--accent);
      color: var(--bg);
      border-color: var(--accent);
      transform: scale(1.05);
      box-shadow: var(--glow);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      font-size: 17px;
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* ─── NOISE OVERLAY ─── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
    }

    /* ─── GRID BACKGROUND ─── */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(0, 212, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
      z-index: 0;
    }

    /* ─── NAV ─── */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 60px;
      background: rgba(5, 10, 15, 0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }

    .nav-logo {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: var(--text);
    }

    .logo-mark {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.82rem;
      letter-spacing: 0.08em;
      color: #031018;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      box-shadow: 0 8px 20px rgba(0, 212, 255, 0.28);
    }

    .logo-text {
      font-size: 1.2rem;
      color: var(--text);
    }

    .nav-links {
      display: flex;
      gap: 36px;
      list-style: none;
    }

    .nav-links a {
      font-family: 'DM Mono', monospace;
      font-size: 0.88rem;
      color: var(--muted);
      text-decoration: none;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: color 0.3s;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    /* ─── HERO ─── */
    #hero {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 120px 60px 80px;
      overflow: hidden;
    }

    .hero-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
    }

    .orb1 {
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(0, 212, 255, 0.12), transparent 70%);
      top: -100px;
      right: -100px;
      animation: pulse 6s ease-in-out infinite;
    }

    .orb2 {
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(123, 97, 255, 0.1), transparent 70%);
      bottom: 0;
      left: 200px;
      animation: pulse 8s ease-in-out infinite 2s;
    }

    @keyframes pulse {

      0%,
      100% {
        transform: scale(1);
        opacity: 1;
      }

      50% {
        transform: scale(1.1);
        opacity: 0.7;
      }
    }

    .hero-content {
      max-width: 800px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 212, 255, 0.08);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 6px 16px;
      font-family: 'DM Mono', monospace;
      font-size: 0.82rem;
      color: var(--accent);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 28px;
      animation: fadeUp 0.8s ease both;
    }

    .badge-dot {
      width: 6px;
      height: 6px;
      background: var(--accent2);
      border-radius: 50%;
      animation: blink 2s ease-in-out infinite;
    }

    @keyframes blink {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.3;
      }
    }

    .hero-name {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(2.2rem, 5.5vw, 4.4rem);
      line-height: 1.0;
      letter-spacing: -0.04em;
      margin-bottom: 20px;
      animation: fadeUp 0.8s ease 0.1s both;
    }

    .hero-name .highlight {
      background: linear-gradient(135deg, var(--accent), var(--accent3));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-title {
      font-family: 'DM Mono', monospace;
      font-size: 1.08rem;
      color: var(--muted);
      margin-bottom: 28px;
      animation: fadeUp 0.8s ease 0.2s both;
      letter-spacing: 0.04em;
    }

    .hero-title span {
      color: var(--accent2);
    }

    .hero-summary {
      font-size: 1.15rem;
      color: var(--muted);
      line-height: 1.75;
      max-width: 640px;
      margin-bottom: 44px;
      animation: fadeUp 0.8s ease 0.3s both;
      font-weight: 300;
    }

    .hero-ctas {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      animation: fadeUp 0.8s ease 0.4s both;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--accent);
      color: var(--bg);
      padding: 14px 28px;
      border-radius: 8px;
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 0.98rem;
      text-decoration: none;
      transition: all 0.3s;
      letter-spacing: 0.02em;
    }

    .btn-primary:hover {
      background: #33deff;
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(0, 212, 255, 0.3);
    }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--border);
      color: var(--text);
      padding: 14px 28px;
      border-radius: 8px;
      font-family: 'Syne', sans-serif;
      font-weight: 600;
      font-size: 0.98rem;
      text-decoration: none;
      transition: all 0.3s;
      backdrop-filter: blur(10px);
    }

    .btn-outline:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
    }

    /* ─── SRE DASHBOARD ─── */
    .hero-grid {
      display: grid;
      grid-template-columns: 1.45fr 1fr;
      gap: 40px;
      align-items: center;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      z-index: 2;
    }

    .hero-dashboard-container {
      width: 100%;
      perspective: 1000px;
    }

    .sre-dashboard {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      backdrop-filter: blur(16px);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4), var(--glow);
      font-family: 'DM Mono', monospace;
      position: relative;
      overflow: hidden;
      transform: rotateY(-5deg);
      transition: transform 0.5s ease;
    }

    .sre-dashboard:hover {
      transform: rotateY(0deg) translateY(-4px);
      border-color: var(--accent);
    }

    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(0, 212, 255, 0.15);
      padding-bottom: 12px;
      margin-bottom: 20px;
      font-size: 0.78rem;
    }

    .dashboard-title {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text);
      font-weight: 500;
      letter-spacing: 0.05em;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      background: var(--accent2);
      border-radius: 50%;
      display: inline-block;
      box-shadow: 0 0 10px var(--accent2);
    }

    .pulse-dot.active {
      animation: ledPulse 1.5s infinite ease-in-out;
    }

    @keyframes ledPulse {

      0%,
      100% {
        opacity: 0.3;
        transform: scale(0.9);
      }

      50% {
        opacity: 1;
        transform: scale(1.1);
        box-shadow: 0 0 12px var(--accent2);
      }
    }

    .dashboard-status {
      color: var(--accent2);
      letter-spacing: 0.05em;
    }

    .dashboard-section {
      margin-bottom: 24px;
    }

    .section-heading {
      font-size: 0.75rem;
      color: var(--muted);
      letter-spacing: 0.1em;
      margin-bottom: 16px;
    }

    /* ─── PIPELINE GRAPH ─── */
    .pipeline-graph {
      position: relative;
      width: 100%;
      height: 75px;
      display: flex;
      align-items: center;
    }

    .pipeline-svg {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 100%;
      height: 60px;
      z-index: 1;
      pointer-events: none;
    }

    .pulse-path {
      animation: pipePulse 3s linear infinite;
    }

    @keyframes pipePulse {
      0% {
        stroke-dashoffset: 115;
      }

      100% {
        stroke-dashoffset: -115;
      }
    }

    .pipeline-nodes {
      display: flex;
      justify-content: space-between;
      width: 100%;
      position: relative;
      z-index: 2;
    }

    .pipeline-node {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 54px;
    }

    .node-icon {
      width: 36px;
      height: 36px;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      transition: all 0.3s;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    .pipeline-node.active .node-icon {
      border-color: var(--accent);
      box-shadow: 0 0 15px rgba(0, 212, 255, 0.25);
    }

    .pipeline-node.active:hover .node-icon {
      background: rgba(0, 212, 255, 0.15);
      transform: scale(1.1);
    }

    .node-text {
      font-size: 0.65rem;
      color: var(--muted);
      margin-top: 6px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pipeline-node.active .node-text {
      color: var(--text);
    }

    /* ─── METRIC CARDS ─── */
    .dashboard-metrics-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    .metric-card {
      background: rgba(5, 10, 15, 0.4);
      border: 1px solid rgba(0, 212, 255, 0.08);
      border-radius: 12px;
      padding: 16px;
    }

    .metric-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.7rem;
      margin-bottom: 10px;
      letter-spacing: 0.05em;
    }

    .metric-label {
      color: var(--muted);
    }

    .metric-value {
      color: var(--accent);
      font-weight: bold;
    }

    .metric-bar-bg {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 10px;
      overflow: hidden;
    }

    .metric-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), var(--accent3));
      border-radius: 10px;
      transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .metric-bar-fill.memory-bar {
      background: linear-gradient(90deg, var(--accent3), var(--accent2));
    }

    /* ─── SYSTEM FOOTER METRICS ─── */
    .dashboard-footer-metrics {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 12px;
      border-top: 1px solid rgba(0, 212, 255, 0.1);
      padding-top: 16px;
      text-align: center;
    }

    .footer-metric {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .fm-title {
      font-size: 0.62rem;
      color: var(--muted);
      letter-spacing: 0.05em;
    }

    .fm-value {
      font-size: 0.95rem;
      font-weight: bold;
    }

    .text-glow-green {
      color: var(--accent2);
      text-shadow: 0 0 10px rgba(0, 255, 157, 0.3);
    }

    .text-glow-blue {
      color: var(--accent);
      text-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
    }

    .pod-status-grid {
      display: grid;
      grid-template-columns: repeat(4, 12px);
      gap: 4px;
      justify-content: center;
      align-items: center;
      height: 100%;
      min-height: 24px;
    }

    .pod-dot {
      width: 7px;
      height: 7px;
      background: var(--accent2);
      border-radius: 50%;
      display: inline-block;
    }

    .pod-dot.active {
      box-shadow: 0 0 4px var(--accent2);
    }

    .pod-dot.pulse-orange {
      background: #ffaa00;
      box-shadow: 0 0 4px #ffaa00;
      animation: podWarning 1.2s infinite alternate ease-in-out;
    }

    @keyframes podWarning {
      0% {
        opacity: 0.4;
      }

      100% {
        opacity: 1;
        box-shadow: 0 0 8px #ffaa00;
      }
    }

    @media (max-width: 992px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 50px;
      }

      .hero-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .sre-dashboard {
        transform: none !important;
        max-width: 500px;
        margin: 0 auto;
      }
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ─── SECTION BASE ─── */
    section {
      position: relative;
      z-index: 1;
      padding: 100px 60px;
    }

    section:not(#hero) {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    section:not(#hero)>* {
      width: min(1180px, 100%);
    }

    .section-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.82rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .section-label::before {
      content: '';
      width: 30px;
      height: 1px;
      background: var(--accent);
    }

    .section-title {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(2rem, 4vw, 3rem);
      letter-spacing: -0.03em;
      margin-bottom: 60px;
      line-height: 1.1;
    }

    /* ─── SKILLS ─── */
    #skills {
      background: var(--bg2);
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }

    .skill-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      transition: all 0.3s;
      backdrop-filter: blur(16px);
    }

    .skill-card:hover {
      border-color: var(--accent);
      transform: translateY(-4px);
      box-shadow: var(--glow);
    }

    .skill-card-icon {
      width: 44px;
      height: 44px;
      background: rgba(0, 212, 255, 0.1);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      margin-bottom: 16px;
    }

    .skill-card-title {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 1.12rem;
      margin-bottom: 12px;
      color: var(--text);
    }

    .skill-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .skill-tag {
      font-family: 'DM Mono', monospace;
      font-size: 0.78rem;
      padding: 4px 10px;
      background: rgba(0, 212, 255, 0.06);
      border: 1px solid rgba(0, 212, 255, 0.12);
      border-radius: 100px;
      color: var(--muted);
      letter-spacing: 0.04em;
    }

    /* ─── EXPERIENCE ─── */
    #experience {
      background: var(--bg);
    }

    .timeline {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 32px;
      max-width: 900px;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 19px;
      top: 0;
      bottom: 0;
      width: 1px;
      background: linear-gradient(to bottom, var(--accent), transparent);
    }

    .timeline-item {
      display: grid;
      grid-template-columns: 40px 1fr;
      gap: 24px;
      align-items: start;
    }

    .timeline-dot {
      width: 40px;
      height: 40px;
      background: var(--bg2);
      border: 2px solid var(--accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      flex-shrink: 0;
      position: relative;
      z-index: 1;
    }

    .timeline-body {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      backdrop-filter: blur(16px);
      transition: all 0.3s;
    }

    .timeline-body:hover {
      border-color: rgba(0, 212, 255, 0.3);
      box-shadow: var(--glow);
    }

    .timeline-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .timeline-role {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 1.2rem;
    }

    .timeline-date {
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      color: var(--accent);
      background: rgba(0, 212, 255, 0.08);
      padding: 4px 12px;
      border-radius: 100px;
      white-space: nowrap;
    }

    .timeline-company {
      font-family: 'DM Mono', monospace;
      font-size: 0.88rem;
      color: var(--accent2);
      margin-bottom: 16px;
      letter-spacing: 0.05em;
    }

    .timeline-bullets {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .timeline-bullets li {
      font-size: 0.98rem;
      color: var(--muted);
      padding-left: 18px;
      position: relative;
      line-height: 1.6;
    }

    .timeline-bullets li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: var(--accent);
      font-size: 0.75rem;
    }

    /* ─── PROJECTS ─── */
    #projects {
      background: var(--bg2);
    }

    .project-filters {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-bottom: 40px;
      flex-wrap: wrap;
    }

    .filter-btn {
      font-family: 'DM Mono', monospace;
      font-size: 0.82rem;
      background: rgba(0, 212, 255, 0.05);
      border: 1px solid var(--border);
      color: var(--muted);
      padding: 8px 18px;
      border-radius: 100px;
      cursor: pointer;
      transition: all 0.3s ease;
      letter-spacing: 0.04em;
      outline: none;
    }

    .filter-btn:hover,
    .filter-btn.active {
      background: var(--accent);
      color: var(--bg);
      border-color: var(--accent);
      box-shadow: var(--glow);
    }

    .project-card.hidden {
      display: none !important;
    }

    .project-card.visible {
      animation: cardFadeIn 0.4s ease forwards;
    }

    @keyframes cardFadeIn {
      from {
        opacity: 0;
        transform: translateY(15px) scale(0.95);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 24px;
    }

    .project-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      overflow: hidden;
      transition: all 0.4s;
      backdrop-filter: blur(16px);
      display: flex;
      flex-direction: column;
    }

    .project-card:hover {
      transform: translateY(-6px);
      border-color: var(--accent);
      box-shadow: 0 20px 60px rgba(0, 212, 255, 0.15);
    }

    .project-header {
      padding: 28px 28px 0;
    }

    .project-number {
      font-family: 'Syne', sans-serif;
      font-size: 3rem;
      font-weight: 800;
      color: rgba(0, 212, 255, 0.1);
      line-height: 1;
      margin-bottom: 12px;
    }

    .project-title {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 1.3rem;
      margin-bottom: 6px;
      line-height: 1.3;
    }

    .project-subtitle {
      font-family: 'DM Mono', monospace;
      font-size: 0.82rem;
      color: var(--accent2);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .project-body {
      padding: 0 28px 28px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .project-desc {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 24px;
      flex: 1;
    }

    .project-desc li {
      font-size: 0.96rem;
      color: var(--muted);
      padding-left: 16px;
      position: relative;
      line-height: 1.6;
    }

    .project-desc li::before {
      content: '·';
      position: absolute;
      left: 4px;
      color: var(--accent);
      font-size: 1.2rem;
      line-height: 1.3;
    }

    .project-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 16px;
    }

    .project-links {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .project-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: 'DM Mono', monospace;
      font-size: 0.76rem;
      color: var(--accent);
      text-decoration: none;
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 6px 12px;
      background: rgba(0, 212, 255, 0.05);
      transition: all 0.3s;
      letter-spacing: 0.03em;
    }

    .project-link:hover {
      color: var(--bg);
      background: var(--accent);
      border-color: var(--accent);
      transform: translateY(-1px);
    }

    .stack-tag {
      font-family: 'DM Mono', monospace;
      font-size: 0.74rem;
      padding: 3px 10px;
      background: rgba(123, 97, 255, 0.1);
      border: 1px solid rgba(123, 97, 255, 0.2);
      border-radius: 100px;
      color: #a990ff;
      letter-spacing: 0.04em;
    }

    /* ─── CASE STUDY MODAL ─── */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(5, 10, 15, 0.85);
      backdrop-filter: blur(12px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      padding: 20px;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .modal-content {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 24px;
      width: min(850px, 100%);
      max-height: 85vh;
      overflow-y: auto;
      position: relative;
      padding: 40px;
      transform: translateY(30px);
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5), var(--glow);
    }

    .modal-overlay.active .modal-content {
      transform: translateY(0);
    }

    .modal-close {
      position: absolute;
      top: 20px;
      right: 20px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: var(--text);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      cursor: pointer;
      transition: all 0.3s;
      outline: none;
    }

    .modal-close:hover {
      background: var(--accent);
      color: var(--bg);
      border-color: var(--accent);
    }

    .modal-header-section {
      margin-bottom: 28px;
    }

    .modal-number {
      font-family: 'Syne', sans-serif;
      font-size: 2.2rem;
      font-weight: 800;
      color: rgba(0, 212, 255, 0.15);
      line-height: 1;
      display: block;
      margin-bottom: 8px;
    }

    .modal-title {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 2rem;
      margin-bottom: 4px;
      color: var(--text);
    }

    .modal-subtitle {
      font-family: 'DM Mono', monospace;
      font-size: 0.9rem;
      color: var(--accent2);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: block;
    }

    .modal-details-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 36px;
    }

    @media (max-width: 768px) {
      .modal-content {
        padding: 30px 20px;
      }

      .modal-details-grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }
    }

    .modal-details-left h4,
    .modal-details-right h4 {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 1.1rem;
      margin-bottom: 16px;
      color: var(--text);
    }

    .modal-desc-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .modal-desc-list li {
      font-size: 0.98rem;
      color: var(--muted);
      padding-left: 20px;
      position: relative;
      line-height: 1.6;
    }

    .modal-desc-list li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: var(--accent);
      font-size: 0.85rem;
    }

    .modal-extra-section p {
      font-size: 0.94rem;
      color: var(--muted);
      line-height: 1.6;
    }

    /* ─── EDUCATION ─── */
    #education {
      background: var(--bg);
    }

    .edu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }

    .edu-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      backdrop-filter: blur(16px);
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }

    .edu-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), var(--accent3));
    }

    .edu-card:hover {
      border-color: rgba(0, 212, 255, 0.3);
      transform: translateY(-4px);
    }

    .edu-degree {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 1.12rem;
      margin-bottom: 6px;
      line-height: 1.3;
    }

    .edu-school {
      font-size: 0.9rem;
      color: var(--accent2);
      font-family: 'DM Mono', monospace;
      margin-bottom: 12px;
      letter-spacing: 0.04em;
    }

    .edu-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    .edu-cgpa {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 1.2rem;
      color: var(--accent);
    }

    .edu-year {
      font-family: 'DM Mono', monospace;
      font-size: 0.78rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    /* ─── CONTACT ─── */
    #contact {
      background: var(--bg2);
      text-align: center;
    }

    .contact-inner {
      max-width: 600px;
      margin: 0 auto;
    }

    .contact-text {
      font-size: 1.08rem;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 44px;
      font-weight: 300;
    }

    .contact-links {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .contact-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 14px 24px;
      border-radius: 10px;
      font-family: 'DM Mono', monospace;
      font-size: 0.9rem;
      text-decoration: none;
      transition: all 0.3s;
      letter-spacing: 0.04em;
      backdrop-filter: blur(16px);
    }

    .contact-link:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
      box-shadow: var(--glow);
    }

    /* ─── FOOTER ─── */
    footer {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 28px 60px;
      border-top: 1px solid var(--border);
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      color: var(--muted);
      letter-spacing: 0.06em;
      background: var(--bg);
    }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 768px) {
      nav {
        padding: 16px 24px;
      }

      .nav-links {
        display: none;
      }

      section {
        padding: 70px 24px;
      }

      #hero {
        padding: 100px 24px 80px;
      }

      body {
        font-size: 16px;
      }

      .hero-stats {
        display: none;
      }

      .hero-name {
        font-size: clamp(2.5rem, 12vw, 5rem);
      }

      footer {
        padding: 24px;
      }
    }

    /* ─── CANVAS BACKGROUND ─── */
    #network-canvas {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      width: 100%;
      height: 100%;
      opacity: 0.65;
    }
  </style>
</head>

